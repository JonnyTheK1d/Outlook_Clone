; Unsigned per-user Windows installer. WriteUninstaller is generated by NSIS,
; so cross-building does not execute a Windows helper under Wine.
Unicode true
!include "MUI2.nsh"
!include "x64.nsh"
!include "WinVer.nsh"
Name "${PRODUCT_NAME}"
InstallDir "$LOCALAPPDATA\Programs\Postblick"
InstallDirRegKey HKCU "Software\Postblick" "InstallDir"
RequestExecutionLevel user
SetCompressor /SOLID lzma
!define MUI_ABORTWARNING
!define MUI_FINISHPAGE_RUN "$INSTDIR\Postblick.exe"
!define MUI_FINISHPAGE_RUN_TEXT "Postblick öffnen"
!insertmacro MUI_PAGE_WELCOME
!insertmacro MUI_PAGE_LICENSE "${PROJECT_DIR}\LICENSE"
!insertmacro MUI_PAGE_DIRECTORY
!insertmacro MUI_PAGE_INSTFILES
!insertmacro MUI_PAGE_FINISH
!insertmacro MUI_UNPAGE_CONFIRM
!insertmacro MUI_UNPAGE_INSTFILES
!insertmacro MUI_UNPAGE_FINISH
!insertmacro MUI_LANGUAGE "German"

Function .onInit
  ${IfNot} ${RunningX64}
    MessageBox MB_OK|MB_ICONSTOP "Postblick benötigt Windows 10/11 (64 Bit)."
    Abort
  ${EndIf}
  ${IfNot} ${AtLeastWin10}
    MessageBox MB_OK|MB_ICONSTOP "Postblick benötigt Windows 10 oder neuer."
    Abort
  ${EndIf}
  SetRegView 64
  SetShellVarContext current
FunctionEnd

Section "Postblick" SEC_APP
  SetOutPath "$INSTDIR"
  File /r "${PROJECT_DIR}\release\win-unpacked\*"
  WriteUninstaller "$INSTDIR\Uninstall Postblick.exe"
  CreateDirectory "$SMPROGRAMS\Postblick"
  CreateShortcut "$SMPROGRAMS\Postblick\Postblick.lnk" "$INSTDIR\Postblick.exe"
  CreateShortcut "$DESKTOP\Postblick.lnk" "$INSTDIR\Postblick.exe"
  WriteRegStr HKCU "Software\Postblick" "InstallDir" "$INSTDIR"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Postblick" "DisplayName" "Postblick"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Postblick" "DisplayVersion" "${VERSION}"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Postblick" "Publisher" "Postblick"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Postblick" "DisplayIcon" "$INSTDIR\Postblick.exe"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Postblick" "InstallLocation" "$INSTDIR"
  WriteRegStr HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Postblick" "UninstallString" '$\"$INSTDIR\Uninstall Postblick.exe$\"'
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Postblick" "NoModify" 1
  WriteRegDWORD HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Postblick" "NoRepair" 1
SectionEnd

Section "Uninstall"
  SetRegView 64
  SetShellVarContext current
  ; Delete exactly the files shipped with this version. Never recursively
  ; delete a user-selected directory or remove the user's mailbox cache.
  !include "${PROJECT_DIR}\release\installed-files.nsh"
  Delete "$INSTDIR\Uninstall Postblick.exe"
  Delete "$SMPROGRAMS\Postblick\Postblick.lnk"
  RMDir "$SMPROGRAMS\Postblick"
  Delete "$DESKTOP\Postblick.lnk"
  DeleteRegKey HKCU "Software\Microsoft\Windows\CurrentVersion\Uninstall\Postblick"
  DeleteRegKey HKCU "Software\Postblick"
  RMDir "$INSTDIR"
SectionEnd
